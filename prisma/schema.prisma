generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id                String   @id @default(cuid())
  name              String
  phone             String
  email             String?
  date              String
  timeSlot          String
  services          String[]
  notes             String?
  reference         String   @unique
  /// Deprecated/retired in SDD v7 (FR-03). Retained for historical schema compatibility.
  discountApplied   Boolean  @default(false)
  inspirationPhotos String[] @default([])
  rescheduleCount   Int      @default(0)
  originalDate      String?
  expiresAt         DateTime?
  paidAt            DateTime?
  submitToken       String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  status            String   @default("pending")
  payment           Payment?
}

/// One charge per booking. `id` is the Paychangu charge id (airtel-…, tnm-…, bank-…).
model Payment {
  id             String    @id
  bookingId      String    @unique
  booking        Booking   @relation(fields: [bookingId], references: [id])
  reference      String
  customerName   String?
  method         String
  mobile         String?
  status         String    @default("pending")
  ids            Json?
  bankDetails    Json?
  note           String?
  lastVerifiedAt DateTime?
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}

model UnavailableDate {
  id        String   @id @default(cuid())
  date      String   @unique
  timeSlots String[]
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isAvailable Boolean  @default(true)
  price       Int?
}

/// Logical service categories (e.g., manicure, pedicure, refills, nail art, soak off)
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id           String @id @default(cuid())
  priceListUrl String
}

/// App-owned customer record. Neon Auth holds the password. Bookings stay keyed by phone.
model CustomerProfile {
  id         String   @id @default(cuid())
  neonUserId String   @unique
  name       String
  email      String   @unique
  phone      String   @unique
  blocked    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// Prepaid gift voucher purchased via Direct Charge (FR-30).
model GiftVoucher {
  id               String                 @id @default(cuid())
  voucherId        String                 @unique
  status           String                 @default("pending") // pending | active | depleted
  purchaseAmount   Int
  remainingBalance Int
  recipientName    String
  recipientEmail   String
  purchaserName    String
  message          String?
  chargeId         String                 @unique
  method           String
  paymentRef       String?
  createdAt        DateTime               @default(now())
  redemptions      GiftVoucherRedemption[]

  @@index([status, createdAt])
}

/// One redemption event against a GiftVoucher (FR-30).
model GiftVoucherRedemption {
  id             String      @id @default(cuid())
  voucherId      String
  voucher        GiftVoucher @relation(fields: [voucherId], references: [id])
  amountDeducted Int
  serviceIds     String[]    @default([])
  serviceNames   String[]    @default([])
  note           String?
  redeemedAt     DateTime    @default(now())

  @@index([voucherId, redeemedAt])
}
